# Supabase（Project Settings → API Keys）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# サーバー専用。通知メールの宛先取得に使う。絶対に NEXT_PUBLIC_ を付けないこと
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# サイトのURL（メール内リンクに使う）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 通知メール（Resend）。未設定ならメール送信はスキップしてログに出すだけ
RESEND_API_KEY=
MAIL_FROM=まなビレッジ <onboarding@resend.dev>
ADMIN_EMAIL=xenon.english@gmail.com

# おしえて英語の AI 判定(DeepSeek)。サーバー専用
DEEPSEEK_API_KEY=
# 朝のメール(Vercel Cron)の呼び出しを守る鍵。長いランダムな文字列
CRON_SECRET=
